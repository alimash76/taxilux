# Copy this file to .env and adjust the values.
# Never commit .env; secrets belong in environment variables only.

# --- Backend ---
DB_PATH=/data/taxilux.db
PORT=8080
LOG_LEVEL=info

# --- Email (Phase 3; SMTP must be EU-based / GDPR compliant) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@{{COMPANY_DOMAIN}}

# --- Recipient addresses per form type (Phase 3) ---
EMAIL_TO_RIDE_REQUEST={{COMPANY_EMAIL}}
EMAIL_TO_COMPLAINT={{COMPANY_EMAIL}}
EMAIL_TO_SUGGESTION={{COMPANY_EMAIL}}
EMAIL_TO_CONTACT={{COMPANY_EMAIL}}

---
import Layout from '../layouts/Layout.astro';
import { getStrings, type Lang } from '../i18n';

const pathname = Astro.url.pathname;
const lang: Lang = pathname.startsWith('/en/') ? 'en' : 'nl';
const s = getStrings(lang);
const backHomeHref = pathname.startsWith('/en/') ? '/en/' : '/nl/';
---

<Layout lang={lang} title={s.notFound}>
  <h1>{s.notFound}</h1>
  <p>
    <a href={backHomeHref}>Terug naar de startpagina · Back to home</a>
  </p>
</Layout>

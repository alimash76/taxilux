---
import Layout from '../../layouts/Layout.astro';
import { getStrings, type Lang } from '../../i18n';

const { lang } = Astro.params as unknown as { lang: Lang };
const s = getStrings(lang);

const siteName = '{{COMPANY_NAME}}';

export function getStaticPaths() {
  return [
    { params: { lang: 'nl' } },
    { params: { lang: 'en' } },
  ];
}
---

<Layout lang={lang} title={s.complaintProcedureTitle} active="feedback">
  <section class="section">
    <div class="wrapper">
      <h1>{siteName} — {s.complaintProcedureTitle}</h1>
      <p>{s.complaintProcedureIntro}</p>
      <p style="color:var(--color-error);font-size:var(--font-scale-small);">{s.complaintProcedurePlaceholder}</p>
      <p>
        <a href={`/${lang}/klachtenformulier`} class="button button-secondary" style="min-width:unset;">{s.complaintFormTitle}</a>
      </p>
    </div>
  </section>
</Layout>

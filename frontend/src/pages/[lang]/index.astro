---
import Layout from '../../layouts/Layout.astro';
import { getStrings, type Lang } from '../../i18n';

const { lang } = Astro.params as unknown as { lang: Lang };
const s = getStrings(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'nl' } },
    { params: { lang: 'en' } },
  ];
}

const siteName = '{{COMPANY_NAME}}';
const tagline = '{{COMPANY_TAGLINE}}';
const phone = '{{COMPANY_PHONE}}';
const email = '{{COMPANY_EMAIL}}';
---

<Layout lang={lang} title={tagline}>
  <h1>{siteName}</h1>
  <p>{tagline}</p>
  <p>{s.placeholder}</p>

  <nav class="cta-group" style="display:flex;flex-direction:column;gap:var(--space-s);margin-top:var(--space-l);">
    <a
      href={`tel:${phone}`}
      class="button button-primary"
      style="min-width:unset;padding:1rem 1.5rem;font-size:1.125rem;"
    >
      {s.callUs}
    </a>
    <a href="#" class="button" style="min-width:unset;padding:1rem 1.5rem;font-size:1.125rem;">
      {s.sendRequest}
    </a>
    <p style="font-size:0.94rem;color:var(--color-text-secondary);margin-top:var(--space-s);">
      {phone} · {email}
    </p>
  </nav>
</Layout>

---
import '../styles/global.css';
import { getStrings, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  active?: string;
}

const { lang, title, active = '' } = Astro.props;
const s = getStrings(lang);

const otherLang: Lang = lang === 'nl' ? 'en' : 'nl';
const otherLangPath = Astro.url.pathname.replace(new RegExp(`/${lang}/`), `/${otherLang}/`);

const siteName = '{{COMPANY_NAME}}';
const tagline = '{{COMPANY_TAGLINE}}';
const phone = '{{COMPANY_PHONE}}';
const email = '{{COMPANY_EMAIL}}';

const navItems = [
  { href: `/${lang}/`, label: s.navHome, key: 'home' },
  { href: `/${lang}/over-ons`, label: s.navAbout, key: 'about' },
  { href: `/${lang}/diensten`, label: s.navServices, key: 'services' },
  { href: `/${lang}/ritsoorten`, label: s.navTripTypes, key: 'trip-types' },
  { href: `/${lang}/boeken`, label: s.navBook, key: 'book' },
  { href: `/${lang}/klachten`, label: s.navFeedback, key: 'feedback' },
  { href: `/${lang}/contact`, label: s.navContact, key: 'contact' },
];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · {siteName}</title>
    <link rel="alternate" hreflang={lang} href={Astro.url.href} />
    <link rel="alternate" hreflang={otherLang} href={otherLangPath} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <a href="#main" class="skip-link">{s.skipContent}</a>

    <header class="site-header">
      <div class="header-inner">
        <a href={`/${lang}/`} class="brand" aria-label={siteName}>{siteName}</a>
        <nav class="nav" aria-label="Hoofdnavigatie · Main navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-link${active === item.key ? ' active' : ''}`}
              aria-current={active === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href={otherLangPath} class="lang-switch">{s.languageSwitch}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Persistent "Request a ride" bar — thumb-reachable on mobile -->
    <div class="cta-bar" role="region" aria-label="Rit aanvragen · Request a ride">
      <div class="cta-inner">
        <details class="cta-details">
          <summary>{s.requestRide}</summary>
          <div class="cta-options">
            <a href={`tel:${phone}`} class="cta-option">
              <span class="opt-label">{s.callUs}</span>
              <span class="opt-hint">{s.callUsLabel.replace('{{COMPANY_PHONE}}', phone)}</span>
            </a>
            <a href={`/${lang}/ritaanvraag`} class="cta-option">
              <span class="opt-label">{s.sendRequest}</span>
              <span class="opt-hint">{s.sendRequestLabel}</span>
            </a>
          </div>
        </details>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>{siteName} · {tagline}</p>
        <p>
          <span>{s.phone}:</span>
          <a href={`tel:${phone}`}>{phone}</a>
          ·
          <span>{s.email}:</span>
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
